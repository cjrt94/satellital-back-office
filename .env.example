# Firebase Client (public - used in browser)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Firebase Admin (server-only - NEVER expose to client)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# API key for lead ingestion endpoints
LEADS_API_KEY=your-secret-api-key-here

# Allowed origin for CORS (your Webflow domain)
ALLOWED_ORIGIN=https://your-webflow-site.com
